{
  "name": "@muse-work/dsh-muse",
  "version": "0.1.0",
  "private": true,
  "description": "Muse workbench for DeepSeek Harness: issues, coordinator tools, and agent-driven execution.",
  "type": "module",
  "exports": {
    ".": "./host.js",
    "./tools": "./tools.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "host.js",
    "tools.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "docs",
    "icon.svg",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true
    }
  }
}
