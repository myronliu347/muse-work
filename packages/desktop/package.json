{
  "name": "@muse-work/desktop",
  "private": true,
  "description": "Muse desktop app (Electron)",
  "version": "0.1.6",
  "productName": "Muse",
  "appId": "com.muse.work",
  "build": {
    "appId": "com.muse.work",
    "productName": "Muse",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/main/**/*",
      "webview/**/*",
      "assets/**/*",
      "package.json",
      "node_modules/node-pty/**/*"
    ],
    "asarUnpack": [
      "node_modules/node-pty/**/*"
    ],
    "extraResources": [
      {
        "from": "dist/muse-server",
        "to": "muse-server",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "dist/muse-server/node_modules",
        "to": "muse-server/node_modules"
      },
      {
        "from": "dist/bundled-hot.json",
        "to": "bundled-hot.json"
      }
    ],
    "afterPack": "./scripts/afterPack.cjs",
    "mac": {
      "icon": "assets/icon.png",
      "category": "public.app-category.developer-tools",
      "executableName": "Muse",
      "target": [
        "dmg"
      ],
      "identity": null
    },
    "asar": true
  },
  "type": "module",
  "main": "./dist/main/index.cjs",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "pnpm run compile",
    "compile": "pnpm run sync:webview && tsup && node scripts/copyServerPlugins.mjs",
    "sync:webview": "node scripts/syncWebview.mjs",
    "brand:dev-electron": "node scripts/brandDevElectron.mjs",
    "prepare:server": "node scripts/prepareServer.mjs",
    "dev": "pnpm -F @muse-work/agent build && pnpm -F @muse-work/provider build && pnpm -F @muse-work/plugin-sdk build && pnpm -F @muse-work/server build && pnpm -F @muse-work/webview build && pnpm run compile && pnpm run brand:dev-electron && node scripts/ensureNodePty.mjs && env -u ELECTRON_RUN_AS_NODE electron . --no-sandbox",
    "dist:mac": "pnpm -F @muse-work/agent build && pnpm -F @muse-work/webview build && pnpm run prepare:server && pnpm run compile && node scripts/packMac.mjs",
    "clean": "node -e \"import('fs').then(fs => ['dist', 'release', 'webview'].forEach(d => {try{fs.rmSync(d, {recursive:true, force:true})}catch(e){}}))\"",
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "ignore": "^7.0.6",
    "node-pty": "1.0.0"
  },
  "devDependencies": {
    "@electron/rebuild": "4.2.0",
    "@types/node": "^25.0.1",
    "electron": "^43.2.0",
    "electron-builder": "26.15.3",
    "esbuild": "0.28.0",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}
