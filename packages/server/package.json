{
  "name": "@muse-work/server",
  "version": "0.1.8",
  "private": true,
  "files": [
    "dist",
    "plugins"
  ],
  "type": "module",
  "bin": {
    "muse-server": "./dist/index.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/copyPlugins.mjs",
    "dev": "MUSE_HOME_DIR=.dev-muse-work tsx src/index.ts",
    "type-check": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.1",
    "@muse-work/provider": "workspace:*",
    "@muse-work/plugin-sdk": "workspace:*",
    "hono": "^4.13.2",
    "@muse-work/agent": "workspace:*",
    "winston": "^3.19.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/ws": "^8.18.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
